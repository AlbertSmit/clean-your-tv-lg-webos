{
  "name": "clean-your-tv-build-tools",
  "private": true,
  "scripts": {
    "dev": "python3 scripts/preview.py --open --port 8765",
    "build:home": "python3 scripts/tv_web_build.py --input launcher --output build/home-app",
    "lint": "eslint launcher root-edition/ui updater-app --max-warnings=0",
    "lint:compat": "npm run lint && node scripts/check-tv-web.cjs",
    "test:compat": "node tests/eslint-compat.cjs && node tests/web-build.cjs",
    "test:legacy-ui": "node tests/legacy-launcher.cjs",
    "test:home-ui": "node tests/home-appearance.cjs",
    "test:widgets": "node tests/widget-data.cjs && node tests/widgets.cjs"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "acorn": "8.19.0",
    "browserslist": "4.29.4",
    "core-js-bundle": "3.51.0",
    "doiuse": "6.0.6",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-compat": "6.2.1",
    "nano-jsx": "0.2.1",
    "parse5": "7.3.0",
    "playwright": "1.64.1",
    "postcss": "8.5.31",
    "postcss-preset-env": "11.6.1",
    "safe-buffer": "5.2.1"
  }
}
